# M5Stack Basic / Gray: ESP32-D0WDQ6, 4 MB flash, no PSRAM. Console on UART0 (CP2104 USB bridge).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE: NimBLE host, peripheral only (Wi-Fi config service).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# log_0001_01.csv is not an 8.3 name
CONFIG_FATFS_LFN_HEAP=y

# Power management: dynamic frequency scaling between LOGBO_CPU_MIN_MHZ and this. Not 240: on the ESP32 a
# switch between 240 and 80 / 160 MHz turns the PLL off for a moment, so the GNSS UART (which holds the APB
# frequency, see components/gnss) would keep the CPU at 240 MHz all the time. 160 <-> 80 keeps the PLL.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# GNSS UART: keep receiving while the cache is off for a flash write (see components/gnss)
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_PM_ENABLE=y
# 1 kHz tick: the IMU and GNSS tasks run at 200 / 25 Hz
CONFIG_FREERTOS_HZ=1000

# Wi-Fi + BLE overflow the classic ESP32's IRAM by default; the Wi-Fi fast paths go to flash (throughput
# is not needed here: a few KB/s of UDP).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
